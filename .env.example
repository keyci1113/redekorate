# Copia este archivo como .env y cambia TODOS los valores.

# Genera con: openssl rand -hex 32   (mínimo 32 caracteres; el servidor no arranca sin él)
JWT_SECRET=
# Contraseña de PostgreSQL. Genera con: openssl rand -base64 24
DB_PASSWORD=

# URL pública, se usa en los correos de recuperación de contraseña
APP_URL=https://research.tudominio.com
PORT=4000

# true = cualquiera puede crear cuenta. Cámbialo a false cuando crees la tuya.
ALLOW_REGISTRATION=true
# Déjalo en true. Ponlo en false solo para probar sin HTTPS.
COOKIE_SECURE=true

# Correo (para recuperar contraseña). Sin esto, el enlace se imprime en los logs del servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Redekorate <no-reply@tudominio.com>"

# Opcional
# UPLOAD_MAX_MB=10
# SESSIONS_PER_IP_HOUR=300
