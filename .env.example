# Copy this file to .env and change ALL the values.

# Generate with: openssl rand -hex 32   (at least 32 characters; the server refuses to start without it)
JWT_SECRET=
# PostgreSQL password. Generate with: openssl rand -base64 24
DB_PASSWORD=

# Public URL, used in password-reset emails
APP_URL=https://research.yourdomain.com
PORT=4000

# true = anyone can create an account. Set it to false once you have created yours.
ALLOW_REGISTRATION=true
# Leave it true. Set it to false only to test without HTTPS.
COOKIE_SECURE=true

# Email (for password recovery). Without it, the reset link is printed to the server logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Redekorate <no-reply@yourdomain.com>"

# Sign in with Google / Microsoft (optional; the button appears only when both values of a provider are set).
# Redirect URI to register at the provider: <APP_URL>/api/auth/oauth/google/callback and /api/auth/oauth/microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Microsoft tenant: "common" (any account), "organizations" (work/school only), "consumers" or your tenant id / domain
MICROSOFT_TENANT=common

# Optional
# UPLOAD_MAX_MB=10
# SESSIONS_PER_IP_HOUR=300
